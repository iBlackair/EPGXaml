<Window x:Class="EPGVirtualization.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EPGVirtualization"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:ffme="clr-namespace:Unosquare.FFME;assembly=ffme.win"
        mc:Ignorable="d"
        Title="EPG Viewer" Height="900" Width="1600" Background="White">
    <Grid x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="20" />
            <RowDefinition Height="1*" />
            <RowDefinition x:Name="EPGRow" Height=".5*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*" />
            <ColumnDefinition Width="1.777*" />                    
        </Grid.ColumnDefinitions>

        <!-- Menu with border -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" BorderBrush="Gray" BorderThickness=".6">
            <Menu>
                <MenuItem Header="_File">
                    <MenuItem Header="New" />
                    <MenuItem Header="Open" />
                    <MenuItem Header="Exit" />
                </MenuItem>
                <MenuItem Header="_Edit" Click="MenuItem_Click">
                    <MenuItem Header="Undo" />
                    <MenuItem Header="Redo" />
                </MenuItem>
                <MenuItem Header="_View">
                    <MenuItem Header="Zoom In" />
                    <MenuItem Header="Zoom Out" Click="MenuItem_Click" />
                </MenuItem>
            </Menu>
        </Border>

        <Border x:Name="DashContainer" Grid.Row="1" Grid.Column="0" Background="#FF1D1B1B">

        </Border>
        <!-- Video panel with dynamic sizing -->

        <Border x:Name="VideoContainer" Grid.Row="1" Grid.Column="1" Panel.ZIndex="1" >
            <!--<Grid x:Name="VideoAspectGrid0">-->
            <ffme:MediaElement Name="media"
                           LoadedBehavior="Manual"
                           UnloadedBehavior="Manual"
                           Stretch="Uniform"
                           Background="Black"
                           MediaFailed="Media_MediaFailed"
                           MessageLogged="Media_MessageLogged"/>
            <!--<wv2:WebView2 x:Name="webView" Grid.Row="1" NavigationCompleted="webView_NavigationCompleted" />-->
            <!--</Grid>-->
        </Border>

        <!-- EPG panel with border -->        
        <Border x:Name="EPGContainer" Grid.Row="2" Grid.ColumnSpan="2" BorderThickness="0,0.6,0,0.6" BorderBrush="Gray" Margin="0,2,0,0"  >
            <local:EPGCanvas x:Name="EPGControl"
                         ViewStartTime="{Binding Today}" 
                         ChannelHeight="40"
                         ChannelLabelWidth="200"
                         TimelineHeight="40"
                         PixelsPerMinute="3"
                         Zoom="0.9"
                         ProgramSelected="EPGControl_ProgramSelected" HorizontalAlignment="Left"
                             />
        </Border>
    </Grid>
</Window>